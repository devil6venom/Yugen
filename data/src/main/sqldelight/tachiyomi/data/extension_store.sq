import kotlin.Boolean;

CREATE TABLE extension_store(
    index_url TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    badge_label TEXT NOT NULL,
    signing_key TEXT NOT NULL,
    contact_website TEXT NOT NULL,
    is_legacy INTEGER AS Boolean NOT NULL,
    extension_list_url TEXT,
    enabled INTEGER AS Boolean NOT NULL DEFAULT 1
);

get:
SELECT *
FROM extension_store
WHERE index_url = :indexUrl;

getAll:
SELECT *
FROM extension_store;

getCount:
SELECT COUNT(*)
FROM extension_store;

upsert:
INSERT INTO extension_store(index_url, name, badge_label, signing_key, contact_website, is_legacy, extension_list_url, enabled)
VALUES (:indexUrl, :name, :badgeLabel, :signingKey, :contactWebsite, :isLegacy, :extensionListUrl, :enabled)
ON CONFLICT(index_url)
DO UPDATE
SET
    name = :name,
    badge_label = :badgeLabel,
    signing_key = :signingKey,
    contact_website = :contactWebsite,
    is_legacy = :isLegacy,
    extension_list_url = :extensionListUrl,
    enabled = :enabled
WHERE index_url = :indexUrl;

updateEnabled:
UPDATE extension_store
SET enabled = :enabled
WHERE index_url = :indexUrl;

delete:
DELETE FROM extension_store
WHERE index_url = :indexUrl;
